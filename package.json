{
  "name": "rinex-viewer",
  "displayName": "rinex-viewer",
  "description": "Enhance the readability of Receiver INdependent EXchange (RINEX) files",
  "repository": {
    "type": "git",
    "url": "https://github.com/HatoGnss/rinex-viewer.git"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "publisher": "hato-gnss",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:rinex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rinex",
        "aliases": [
          "RINEX"
        ],
        "extensions": [
          ".00o",
          ".01o",
          ".02o",
          ".03o",
          ".04o",
          ".05o",
          ".06o",
          ".07o",
          ".08o",
          ".09o",
          ".10o",
          ".11o",
          ".12o",
          ".13o",
          ".14o",
          ".15o",
          ".16o",
          ".17o",
          ".18o",
          ".19o",
          ".20o",
          ".21o",
          ".22o",
          ".23o",
          ".24o",
          ".25o",
          ".26o",
          ".27o",
          ".28o",
          ".29o",
          ".30o",
          ".obs",
          ".rxo"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --ext ts",
    "test": "npm run compile-tests && node --test out/test/unit/*.test.js",
    "pretest:integration": "npm run compile-tests && npm run compile",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
